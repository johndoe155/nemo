{
  "name": "oc-universe-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Nemoverse — Hub frontend. One canon, infinite versions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:blackhole": "node scripts/verify-blackhole.mjs",
    "generate:nemo-loader": "node scripts/generate-nemo-loader.mjs",
    "verify:nemo-loader": "node scripts/verify-nemo-loader.mjs",
    "verify:nemo-particles": "node scripts/verify-nemo-particles.mjs",
    "generate:persona-points": "node scripts/generate-persona-points.mjs",
    "test:unit": "node --import ./tests/unit/register-ts.mjs --test \"tests/unit/**/*.test.ts\"",
    "test": "npm run test:unit",
    "test:signoff-horizon": "playwright test",
    "generate:fonts": "node scripts/subset-fonts.mjs",
    "test:a11y": "playwright test a11y-axe.spec.ts",
    "budget": "node scripts/budget.mjs",
    "test:visual": "playwright test visual-regression.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/michroma": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fontkit": "^2.0.4",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
